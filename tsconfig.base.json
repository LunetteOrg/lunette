{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Dead code fails the build rather than accumulating. `noUnusedParameters`
    // still allows a leading underscore, which is how a step names the
    // positions it does not read (`_app`, `_ctx`) — the signature is the
    // declaration, so those parameters have to stay written.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Named EXPLICITLY, because the alternative is arriving by accident: left
    // unset, these globals are in the program only while some dependency
    // happens to pull @types/node in, which is not a dependency anything
    // declares. Two things need them: the toolchain — the vitest configs and
    // every `*.config.ts` compile as Node — and the platform types the read
    // steps stand on, `Request` and `File` by name and the rest through what
    // `request.formData()` hands back. A package targeting another runtime
    // overrides `types` in its own tsconfig.
    "types": ["node"]
  }
}
