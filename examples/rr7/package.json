{
  "name": "@lntt/example-rr7",
  "version": "0.0.0",
  "private": true,
  "description": "Example: @lntt/example-app as a REAL React Router 7 app (framework mode, v8_middleware), scopes mounted as resource routes, with an end-to-end test against the built server.",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@lntt/example-app": "workspace:*",
    "@lntt/integration": "workspace:*",
    "@lntt/scope": "workspace:*",
    "@lntt/wire": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@react-router/dev": "^7.18.2",
    "@react-router/node": "^7.18.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.5",
    "vitest": "^3.2.0",
    "zod": "^3.25.76"
  }
}
