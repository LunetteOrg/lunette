{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Workerd WITH node compatibility, which is what this entry is about: the
    // runtime globals and the `cloudflare:*` modules come from
    // `worker-configuration.d.ts` (generated by `wrangler types` from
    // wrangler.jsonc, so the bindings are typed too), and `node` is named
    // because the Express types are written against node:http — the very APIs
    // `nodejs_compat` supplies here.
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "test", "vitest.config.ts", "worker-configuration.d.ts"]
}
