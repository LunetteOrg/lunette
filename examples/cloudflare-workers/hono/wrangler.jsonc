{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lntt-example-workers-hono",
  "main": "src/server.ts",
  // `import { env } from 'cloudflare:workers'` needs a runtime that ships it.
  "compatibility_date": "2026-08-01",
  // The binding the store layer reads at build time. Locally Miniflare serves it
  // with no account and no credentials, which is why the tests need neither.
  "kv_namespaces": [{ "binding": "LINKS", "id": "links-namespace" }],
  "vars": {
    "LABEL": "hono on workers",
    // A real deployment makes this a SECRET (`wrangler secret put`), which
    // reaches `env` the same way — the config module cannot tell the difference.
    "SIGNING_SECRET": "dev-secret-not-for-deployment"
  }
}
