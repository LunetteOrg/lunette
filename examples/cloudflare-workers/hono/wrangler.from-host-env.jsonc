{
  "$schema": "node_modules/wrangler/config-schema.json",
  // `wrangler.jsonc` with a different `main`: the entry whose seed comes from
  // Hono's per-request `c.env` instead of the module-scope `cloudflare:workers`
  // import. Its OWN kv namespace id, so the parity test drives two workers that
  // do not share storage and the comparison is between equals.
  "name": "lntt-example-workers-hono-from-host-env",
  "main": "src/server-from-host-env.ts",
  "compatibility_date": "2026-08-01",
  "kv_namespaces": [{ "binding": "LINKS", "id": "links-namespace-from-host-env" }],
  "vars": {
    "LABEL": "hono on workers",
    "SIGNING_SECRET": "dev-secret-not-for-deployment"
  }
}
