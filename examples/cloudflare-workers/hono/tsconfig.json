{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // This package targets WORKERD, not Node. The runtime globals and the
    // `cloudflare:*` module declarations come from `worker-configuration.d.ts`,
    // which `wrangler types` generates from wrangler.jsonc — so the BINDINGS in
    // that file are typed too, and adding one without declaring it is a compile
    // error. `pnpm typecheck` regenerates it first, the way the React Router
    // entry regenerates its route types.
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "test", "vitest.config.ts", "worker-configuration.d.ts"]
}
