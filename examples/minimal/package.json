{
  "name": "@lntt/example-minimal",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal example: ONE @lntt/scope fragment model served across four hosts (Hono, Express, React Router 7, tRPC) via @lntt/integration. In-memory domain, no database.",
