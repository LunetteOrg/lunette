{
  "name": "@lntt/wire",
  "version": "0.0.0",
  "description": "Typed dependency wiring as a chain of layers \u2014 Effect-grade composition with plain functions: no monads, no decorators, no reflection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunetteOrg/lunette.git",
    "directory": "packages/wire"
  },
  "homepage": "https://github.com/LunetteOrg/lunette/tree/main/packages/wire#readme",
  "bugs": "https://github.com/LunetteOrg/lunette/issues",
  "type": "module",
  "exports": {
    ".": {
      "@lntt/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "@lntt/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lntt/wire": "workspace:*",
    "@types/node": "^24.13.2",
    "typescript": "catalog:",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/fixture/**",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "typescript": ">=7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
