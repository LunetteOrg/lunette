{
  "name": "@lntt/integration",
  "version": "0.0.0",
  "description": "Host integrations for @lntt/scope: wire's scope runtime as a guest of Hono, Express, React Router 7, and tRPC. Tree-shakable per-host subpaths.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./hono": "./src/hono.ts",
    "./express": "./src/express.ts",
    "./http": "./src/http.ts",
    "./node": "./src/node.ts",
    "./react-router": "./src/react-router.ts",
    "./trpc": "./src/trpc.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lntt/scope": "workspace:*",
    "@lntt/wire": "workspace:*",
    "@standard-schema/spec": "^1.0.0"
  },
  "peerDependencies": {
    "@hono/standard-validator": ">=0.1",
    "@trpc/server": ">=11",
    "express": ">=5",
    "hono": ">=4",
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "@hono/standard-validator": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@trpc/server": "^11.18.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^24.13.2",
    "express": "^5.2.1",
    "hono": "^4.12.25",
    "react-router": "^7.18.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "zod": "^3.25.76"
  }
}
