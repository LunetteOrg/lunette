{
  "name": "@lntt/scope",
  "version": "0.0.0",
  "description": "The host-agnostic scope runtime for @lntt/wire: a scope (guard/leaf) model run as a typed fold. Framework-free — the host integrations live in @lntt/integration; carrier extensions ship as tree-shakable subpaths, each owning its own input channel and outcome vocabulary (./http, ./body, ./cookies, ./headers, ./request).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./body": "./src/extensions/body.ts",
    "./cookies": "./src/extensions/cookies.ts",
    "./headers": "./src/extensions/headers.ts",
    "./http": "./src/extensions/http.ts",
    "./request": "./src/extensions/request.ts",
    "./trpc": "./src/extensions/trpc.ts",
    "./react-router": "./src/extensions/react-router.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "peerDependencies": {
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "react-router": "^7.18.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "zod": "^3.25.0"
  }
}
