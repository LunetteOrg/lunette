{
  "name": "@lntt/scope",
  "version": "0.0.0",
  "description": "The host-agnostic scope runtime for @lntt/wire. ONE primitive \u2014 a step wrapping the rest of the fold \u2014 and a scope IS the function that runs it. Framework-free: a carrier is __args alone and ships as a tree-shakable subpath carrying its host's own mount, so the core names no host and takes no dependency. Express, Hono, tRPC and React Router ship, beside the guard extension.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@lntt/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "@lntt/source": "./src/express/index.ts",
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    },
    "./hono": {
      "@lntt/source": "./src/hono/index.ts",
      "types": "./dist/hono/index.d.ts",
      "import": "./dist/hono/index.js"
    },
    "./trpc": {
      "@lntt/source": "./src/trpc/index.ts",
      "types": "./dist/trpc/index.d.ts",
      "import": "./dist/trpc/index.js"
    },
    "./react-router": {
      "@lntt/source": "./src/react-router/index.ts",
      "types": "./dist/react-router/index.d.ts",
      "import": "./dist/react-router/index.js"
    },
    "./guard": {
      "@lntt/source": "./src/guard/index.ts",
      "types": "./dist/guard/index.d.ts",
      "import": "./dist/guard/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lntt/scope": "workspace:*",
    "@trpc/server": "11.18.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^24.13.2",
    "@types/supertest": "^7.2.1",
    "express": "5.2.1",
    "hono": "4.13.5",
    "react-router": "7.18.3",
    "supertest": "^7.2.2",
    "typescript": "catalog:",
    "vitest": "^4.1.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@trpc/server": ">=11",
    "@types/express": ">=5",
    "@types/express-serve-static-core": ">=5",
    "express": ">=5",
    "hono": ">=4",
    "react-router": ">=7",
    "typescript": ">=7"
  },
  "peerDependenciesMeta": {
    "@trpc/server": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "@types/express-serve-static-core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/fixture/**",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
